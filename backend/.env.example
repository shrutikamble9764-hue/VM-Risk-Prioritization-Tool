# ============================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub (it's already
# in .gitignore).
# ============================================================

# PostgreSQL connection string. You'll get this from Render/Railway
# when you create a free Postgres database. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://user:password@localhost:5432/vmplatform"

# Any long random string - used to sign login tokens.
JWT_SECRET="change-this-to-a-long-random-string"

# Resend.com API key (free account -> API Keys -> Create).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The "from" email address for alerts. On Resend's free tier,
# before you verify your own domain, you must use:
# onboarding@resend.dev
ALERT_FROM_EMAIL="onboarding@resend.dev"

# Where escalation emails (SLA breach) go, in addition to the owner.
CISO_ESCALATION_EMAIL="ciso@example.com"

# Port the API server listens on.
PORT=4000

# Comma separated list of frontend URLs allowed to call this API (CORS).
# REQUIRED for the API to be usable from a browser - no wildcard fallback exists.
# Example: https://vm-platform-xxxx.vercel.app
FRONTEND_URL="http://localhost:5173"
